---
import PostRow from './PostRow.astro';
import type { Post } from '../lib/posts';

interface Props {
  posts: Post[];
  emptyText?: string;
}

const { posts, emptyText = '这里还空着，第一篇正在路上。' } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty">{emptyText}</p>
  ) : (
    <div>
      {posts.map((post) => (
        <PostRow post={post} />
      ))}
    </div>
  )
}
