---
import { url } from '../lib/url';
import { fmt, readingTime, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const minutes = readingTime(post.body);
---

<a class="post-row" href={url(`/posts/${post.id}/`)}>
  <time class="post-row__date" datetime={post.data.pubDate.toISOString()}>
    {fmt(post.data.pubDate)}
  </time>
  <div>
    <h2 class="post-row__title">{post.data.title}</h2>
    {post.data.description && <p class="post-row__desc">{post.data.description}</p>}
  </div>
  <span class="post-row__time">{minutes} min</span>
</a>
