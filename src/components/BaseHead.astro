---
import { SITE } from '../consts';
import { absUrl, url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const { title, description, type = 'website', publishedTime } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
<link rel="canonical" href={canonical} />

<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
<link rel="alternate" type="application/rss+xml" title={`${SITE.title} · RSS`} href={absUrl('/rss.xml', Astro.site)} />

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content="zh_CN" />
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
<meta name="twitter:card" content="summary" />

<meta name="theme-color" content="#fbf9f5" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#131211" media="(prefers-color-scheme: dark)" />

<script is:inline>
  (() => {
    try {
      const stored = localStorage.getItem('theme');
      const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = stored || (dark ? 'dark' : 'light');
    } catch (_) {
      document.documentElement.dataset.theme = 'light';
    }
  })();
</script>
