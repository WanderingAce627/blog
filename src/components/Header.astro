---
import { SITE } from '../consts';
import { url } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';

const BASE = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/+$/, '');
const current = (Astro.url.pathname.replace(BASE, '') || '/').replace(/\/+$/, '') || '/';

const isActive = (href: string) => current === href || current === `${href}/`;
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href={url('/')} class="brand" aria-label={`${SITE.title} 首页`}>
      <span class="brand__mark" aria-hidden="true"></span>
      <span class="brand__name">{SITE.title}</span>
      {SITE.titleEn && <span class="brand__sub">{SITE.titleEn}</span>}
    </a>

    <nav class="nav" aria-label="主导航">
      {
        SITE.nav.map((item) => (
          <a
            href={url(item.href)}
            class="nav__link"
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <ThemeToggle />
  </div>
</header>
