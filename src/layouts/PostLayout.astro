---
import { url } from '../lib/url';
import { categoryLabel, fmt, fmtLong, tagSlug, type Post } from '../lib/posts';
import type { MarkdownHeading } from 'astro';

interface Props {
  post: Post;
  readingMinutes: number;
  headings: MarkdownHeading[];
  prev?: Post;
  next?: Post;
}

const { post, readingMinutes, headings, prev, next } = Astro.props;
const d = post.data;
const updated = d.updatedDate && d.updatedDate.valueOf() !== d.pubDate.valueOf() ? d.updatedDate : null;

// 只保留 h2 / h3，且至少两个标题才显示目录
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = toc.length >= 2;
---

<article>
  <div class="wrap">
    <header class="post-header rise">
      <div class="post-header__meta">
        <span class="post-header__cat">{categoryLabel(d.category)}</span>
        <time datetime={d.pubDate.toISOString()}>{fmtLong(d.pubDate)}</time>
        <span>约 {readingMinutes} 分钟</span>
        {updated && <span>修订于 {fmt(updated)}</span>}
      </div>

      <h1 class="post-header__title">{d.title}</h1>
      {d.description && <p class="post-header__desc">{d.description}</p>}

      {
        d.tags.length > 0 && (
          <div class="tags">
            {d.tags.map((tag) => (
              <a class="tag" href={url(`/tags/${tagSlug(tag)}`)}>
                #{tag}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class="post-body">
      <div class="prose">
        <slot />
      </div>

      {
        showToc && (
          <aside class="toc" aria-label="本文目录">
            <p class="toc__title">目录</p>
            <ul>
              {toc.map((h) => (
                <li>
                  <a class:list={[`depth-${h.depth}`]} href={`#${h.slug}`}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>

    {
      d.attachments.length > 0 && (
        <aside class="attachments" aria-label="附件">
          <p class="attachments__title">附件</p>
          <ul class="attachments__list">
            {d.attachments.map((file) => (
              <li>
                {/* file.url 由后台写入，已包含 /blog 前缀，直接用 */}
                <a href={file.url} target="_blank" rel="noopener">
                  {file.name || file.url.split('/').pop()}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }

    <nav class="post-nav" aria-label="文章导航">
      {
        prev && (
          <a class="post-nav__item" href={url(`/posts/${prev.id}/`)}>
            <div class="post-nav__label">← 上一篇</div>
            <div class="post-nav__title">{prev.data.title}</div>
          </a>
        )
      }
      {
        next && (
          <a class="post-nav__item post-nav__item--next" href={url(`/posts/${next.id}/`)}>
            <div class="post-nav__label">下一篇 →</div>
            <div class="post-nav__title">{next.data.title}</div>
          </a>
        )
      }
    </nav>
  </div>
</article>
